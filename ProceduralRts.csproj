  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="addons\map_authoring\editor\**\*.cs" />
    <Compile Remove="addons\map_authoring\nodes\**\*.cs" />
    <Compile Remove="addons\map_authoring\projection\**\*.cs" />
    <Compile Remove="addons\map_authoring\qa\**\*.cs" />
  </ItemGroup>
</Project>
